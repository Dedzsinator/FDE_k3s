# FDE Platform — configuration template
# Copy to .env, fill in your values, then run ./install.sh
# OR just run ./install.sh — it will prompt and generate .env automatically.
#
# .env is gitignored. Never commit it.

FDE_NODE_IP=192.168.1.10          # K8s node IP (must be reachable from all clients)
FDE_DOMAIN=fde-essen.local        # Base domain for ingress hostnames
FDE_NS=uns                        # Kubernetes namespace

# Service passwords — installer generates random values if left as CHANGEME
FDE_PW_CLICKHOUSE=CHANGEME
FDE_PW_NEO4J=CHANGEME
FDE_PW_IGNITION=CHANGEME
FDE_PW_GRAFANA=CHANGEME
FDE_PW_PGADMIN=CHANGEME

# Optional
FDE_VLLM_URL=                     # vLLM inference endpoint (blank = skip LLM features)
